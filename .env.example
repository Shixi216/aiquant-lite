# LLM providers (leave unused providers empty)
DEEPSEEK_API_KEY=
OPC_DEEPSEEK_BASE_URL=https://api.deepseek.com
OPC_DEEPSEEK_MODEL=deepseek-v4-pro
LONGCAT_API_KEY=
OPC_LONGCAT_BASE_URL=https://api.longcat.chat/openai/v1
OPC_LONGCAT_MODEL=LongCat-2.0
DASHSCOPE_API_KEY=
OPC_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPC_QWEN_MODEL=qwen3.7-plus
XIAOMI_API_KEY=
OPC_MIMO_BASE_URL=
OPC_MIMO_MODEL=mimo-v2.5
TOKENHUB_API_KEY=

# Financial data
TUSHARE_TOKEN=

# Optional search
TAVILY_API_KEY=

# Optional local WeCom simulation/integration (leave empty when unused)
WECOM_HOME_CHANNEL=
WECOM_SECRET=
WECOM_WEBHOOK=
WECOM_ACCESS_TOKEN=

# Local services
OPC_DATABASE_PATH=database/hermes_opc.duckdb
OPC_LOG_LEVEL=INFO
OPC_ROUTER_HOST=127.0.0.1
OPC_ROUTER_PORT=8765
OPC_MCP_HOST=127.0.0.1
OPC_MCP_PORT=8767
OPC_MCP_TRANSPORT=stdio
OPC_NO_PROXY=localhost,127.0.0.1,.eastmoney.com,.tushare.pro,.baostock.com,.cninfo.com.cn

# Canonical data policy
CANONICAL_MARKET_SOURCE_PRIORITY=Tushare Pro,AKShare / Eastmoney,BaoStock
CANONICAL_FINANCIAL_SOURCE_PRIORITY=Tushare Pro,CNInfo,AKShare,BaoStock
CANONICAL_PRICE_TOLERANCE=0.005
CANONICAL_VOLUME_TOLERANCE=0.01
CANONICAL_FINANCIAL_TOLERANCE=0.01

# Fundamental point-in-time policy
FUNDAMENTAL_DISCLOSURE_DATE_AVAILABLE_HOUR=18
FUNDAMENTAL_STALE_ANNUAL_DAYS=500
FUNDAMENTAL_STALE_SEMIANNUAL_DAYS=260
FUNDAMENTAL_STALE_QUARTERLY_DAYS=150
FUNDAMENTAL_CONFIDENCE_VERIFIED=1.0
FUNDAMENTAL_CONFIDENCE_SINGLE_SOURCE=0.6
FUNDAMENTAL_CONFIDENCE_DISCLOSURE_MISSING=0.2
FUNDAMENTAL_CONFIDENCE_CONFLICT=0.0
FUNDAMENTAL_CURRENT_FETCH_MAX_AGE_DAYS=7
FUNDAMENTAL_FETCH_LOOKBACK_DAYS=550
FUNDAMENTAL_FETCH_MAX_ATTEMPTS=2

# Sentiment v1 deterministic policy (all sentiment factors stay shadow-only)
SENTIMENT_SOURCE_OFFICIAL_WEIGHT=1.0
SENTIMENT_SOURCE_AUTHORITATIVE_MEDIA_WEIGHT=0.8
SENTIMENT_SOURCE_MEDIA_WEIGHT=0.5
SENTIMENT_SOURCE_ANALYST_WEIGHT=0.4
SENTIMENT_SOURCE_UNKNOWN_WEIGHT=0.2
SENTIMENT_SOURCE_RUMOR_WEIGHT=0.1
SENTIMENT_VERIFICATION_OFFICIAL_WEIGHT=1.0
SENTIMENT_VERIFICATION_MULTI_SOURCE_WEIGHT=0.9
SENTIMENT_VERIFICATION_SINGLE_OFFICIAL_WEIGHT=0.85
SENTIMENT_VERIFICATION_SINGLE_MEDIA_WEIGHT=0.5
SENTIMENT_VERIFICATION_CONFLICT_WEIGHT=0.0
SENTIMENT_VERIFICATION_UNVERIFIED_WEIGHT=0.25
SENTIMENT_VERIFICATION_RETRACTED_WEIGHT=0.0
SENTIMENT_HALF_LIFE_INTRADAY_HOURS=6
SENTIMENT_HALF_LIFE_1D_HOURS=24
SENTIMENT_HALF_LIFE_1_5D_HOURS=72
SENTIMENT_HALF_LIFE_1_4W_HOURS=336
SENTIMENT_HALF_LIFE_LONG_TERM_HOURS=2160
SENTIMENT_HALF_LIFE_UNKNOWN_HOURS=48
SENTIMENT_MAX_SINGLE_EVENT_CONTRIBUTION=0.5
SENTIMENT_MODEL_MAX_RETRIES=1
SENTIMENT_MAX_EVENTS_PER_REQUEST=20
SENTIMENT_ESCALATION_CONFIDENCE_THRESHOLD=0.45
SENTIMENT_ESCALATION_INTENSITY_THRESHOLD=0.85
SENTIMENT_EXPECTED_MARKET_UNIVERSE_SIZE=5000
SENTIMENT_MARKET_PARTIAL_CONFIDENCE_CAP=0.35
SENTIMENT_BACKFILL_MODEL_CALL_BUDGET=10

# Full-market data foundation safety budgets
FULL_MARKET_UNIVERSE_REQUEST_BUDGET=3
FULL_MARKET_SNAPSHOT_REQUEST_BUDGET=1
FULL_MARKET_SNAPSHOT_MAX_AGE_SECONDS=300
FULL_MARKET_EXPANSION_REQUEST_BUDGET=10
FULL_MARKET_EVENT_BATCH_SIZE=100
FULL_MARKET_CANDIDATE_LIMIT=20
FULL_MARKET_CANDIDATE_MODEL_CALL_LIMIT=10

# Historical daily-bar expansion (RAW, CNY, shares; bounded and resumable)
HISTORY_DEFAULT_ADJUSTMENT=RAW
HISTORY_DEFAULT_PROVIDER=BAOSTOCK
HISTORY_BATCH_SIZE=100
HISTORY_CONCURRENCY=1
HISTORY_REQUEST_BUDGET=100
