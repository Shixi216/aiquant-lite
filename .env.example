# LLM providers (leave unused providers empty)
DEEPSEEK_API_KEY=
OPC_DEEPSEEK_BASE_URL=https://api.deepseek.com
OPC_DEEPSEEK_MODEL=deepseek-v4-pro
LONGCAT_API_KEY=
DASHSCOPE_API_KEY=
XIAOMI_API_KEY=
XIAOMI_BASE_URL=
OPC_MIMO_MODEL=mimo-v2.5
TOKENHUB_API_KEY=

# Financial data
TUSHARE_TOKEN=

# Optional search
TAVILY_API_KEY=

# Local services
OPC_DATABASE_PATH=database/hermes_opc.duckdb
OPC_LOG_LEVEL=INFO
OPC_ROUTER_HOST=127.0.0.1
OPC_ROUTER_PORT=8765
OPC_MCP_HOST=127.0.0.1
OPC_MCP_PORT=8767
OPC_MCP_TRANSPORT=stdio
OPC_NO_PROXY=localhost,127.0.0.1,.eastmoney.com,.tushare.pro,.baostock.com,.cninfo.com.cn

# Trading safety: this release has no live broker implementation. Keep false.
OPC_LIVE_TRADING_ENABLED=false
# No broker account, password, trading password, Cookie, token, or key variables are accepted.
